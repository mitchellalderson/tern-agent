     "kind": "choice",
     "choices": [
      "host",
      "docker"
     ],
     "optional": false,
     "value": "host",
     "default": "host",
     "set": false,
     "description": "Where shell commands run: \"host\" (this computer, in an OS sandbox) or \"docker\" (a container per command).",
