{
 "path": "/Users/you/.tern/config.toml",
 "sections": [
  {
   "id": "general",
   "title": "General",
   "settings": [
    {
     "key": "workspace",
     "kind": "text",
     "optional": false,
     "value": "~/tern-workspace",
     "default": "~/tern-workspace",
     "set": false,
     "description": "where the agent works; shell commands start here",
     "applies": "restart",
     "restart_pending": false,
     "risky": false,
     "editable": true,
     "group": "general",
     "advanced": false,
     "restart_required": true
    },
    {
     "key": "max_iterations",
     "kind": "int",
     "min": 1.0,
     "optional": false,
     "value": 40,
     "default": 40,
     "set": false,
     "description": "model calls per run before it stops",
     "applies": "restart",
     "restart_pending": false,
     "risky": false,
     "editable": true,
     "group": "limits",
     "advanced": false,
     "restart_required": true
    },
    {
     "key": "secret_request_timeout_secs",
     "kind": "int",
     "min": 1.0,
     "optional": false,
     "value": 900,
     "default": 900,
     "set": false,
     "description": "Secrets (API keys, tokens) are read from environment variables first, then from secrets.toml next to this file (which must be mode 0600). The agent can ask you for one with a private prompt; it waits this long.",
     "applies": "restart",
     "restart_pending": false,
     "risky": false,
     "editable": true,
     "group": "advanced",
     "advanced": true,
     "restart_required": true
    },
    {
     "key": "autonomy",
     "kind": "choice",
     "choices": [
      "readonly",
      "supervised",
      "autonomous",
      "yolo"
     ],
     "optional": false,
     "value": "supervised",
     "default": "supervised",
     "set": false,
     "description": "How much runs may do without asking: \"readonly\", \"supervised\" (the default), \"autonomous\" (untainted writes don't ask) or \"yolo\" (nothing asks; doctor shows it in red). Routines can set their own.",
     "applies": "restart",
     "restart_pending": false,
     "security": "How much tern may do without asking, for every agent that doesn't set its own. Autonomous stops asking for ordinary writes; yolo asks for nothing, even in a run that read untrusted content.",
     "risky": false,
     "editable": true,
     "group": "permissions",
     "advanced": false,
     "restart_required": true
    }
   ]
  },
  {
   "id": "models",
   "title": "Models",
   "settings": [
    {
     "key": "default_model",
     "kind": "model",
     "optional": true,
     "value": null,
     "default": null,
     "set": false,
     "description": "Model used when none is given, as \"provider:model\". A list is a fallback chain: when a call to the first fails with an overload, a server error, a rate limit, a network error or an auth/billing error (after its retries), the same call goes to the next. Bad requests never fall back. Any run on the first model gets the chain, whatever picked it.",
     "applies": "live",
     "restart_pending": false,
     "risky": false,
     "editable": true,
     "group": "models",
     "advanced": false,
     "restart_required": false
    },
    {
     "key": "context_window",
     "kind": "int",
     "min": 1000.0,
     "optional": false,
     "value": 128000,
     "default": 128000,
     "set": false,
     "description": "Model context window in tokens; old messages are summarized past 75%. Override per provider with `context_window` in its [providers.*] table.",
     "applies": "restart",
     "restart_pending": false,
     "risky": false,
     "editable": true,
     "group": "models",
     "advanced": true,
     "restart_required": true
    }
   ]
  },
  {
