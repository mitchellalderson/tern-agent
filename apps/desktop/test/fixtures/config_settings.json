     "description": "IP networking for shell commands; false: none",
     "applies": "restart",
     "restart_pending": false,
     "security": "On: shell commands can reach the internet, which also gets around the hosts a connector is allowed to reach.",
     "risky": true,
     "editable": true,
     "group": "permissions",
     "advanced": false,
     "restart_required": true
    },
    {
     "key": "sandbox.confine",
     "kind": "choice",
     "choices": [
      "auto",
      "required",
      "off"
     ],
     "optional": false,
     "value": "auto",
     "default": "auto",
     "set": true,
     "description": "Host backend: shell commands run in an OS sandbox (Seatbelt on macOS, Landlock on Linux): write only to the workspace and temp dirs, no reads of your home directory beyond these paths. See docs/sandbox-design.md.",
     "applies": "restart",
     "restart_pending": false,
     "security": "Off (or auto where the OS sandbox is missing): shell commands can read and write anywhere you can.",
     "risky": false,
     "editable": true,
     "group": "permissions",
     "advanced": false,
     "restart_required": true
    },
