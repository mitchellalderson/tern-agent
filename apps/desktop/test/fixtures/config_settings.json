     "restart_pending": false,
     "risky": false,
     "editable": true,
     "group": "permissions",
     "advanced": false,
     "restart_required": true
    },
    {
     "key": "sandbox.shell_timeout_secs",
     "kind": "int",
     "min": 1.0,
     "optional": false,
     "value": 120,
     "default": 120,
     "set": false,
     "description": "a command running longer is stopped",
     "applies": "restart",
     "restart_pending": false,
